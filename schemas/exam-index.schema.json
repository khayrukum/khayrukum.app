{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "exam-index",
  "type": "object",
  "required": [
    "schema",
    "version",
    "exams"
  ],
  "properties": {
    "schema": {
      "const": "exam-index"
    },
    "version": {
      "type": "string"
    },
    "exams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "title",
          "short",
          "card",
          "range",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "quran",
              "tuhfa"
            ]
          },
          "status": {
            "enum": [
              "published",
              "soon"
            ]
          },
          "title": {
            "type": "string"
          },
          "short": {
            "type": "string"
          },
          "sub": {
            "type": "string"
          },
          "card": {
            "type": "string"
          },
          "intro": {
            "type": "string"
          },
          "sura": {
            "type": "integer"
          },
          "range": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "rubs": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "file": {
            "type": "string"
          },
          "unit": {
            "enum": [
              "آية",
              "بيت"
            ]
          },
          "audio": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
