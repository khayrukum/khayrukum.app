{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "quran-source",
  "type": "object",
  "required": [
    "source",
    "edition",
    "version",
    "url",
    "retrieved",
    "sha256",
    "options",
    "notice"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "options": {
      "type": "object",
      "required": [
        "pauseMarks",
        "sajdah",
        "rubElHizb",
        "superscriptAlefTatweel",
        "basmala"
      ]
    }
  }
}
