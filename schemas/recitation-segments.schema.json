{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "recitation-segments",
  "description": "`segments` of a `quran` audio collection whose items are part files (AUD-34): part id → verse starts and speech cues. Written by tools/audio/import-recitation.mjs.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "verses",
      "cues"
    ],
    "additionalProperties": false,
    "properties": {
      "verses": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": [
            {
              "type": "string",
              "pattern": "^(\\d+:\\d+|bas\\d+|pre0)$"
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "enum": [
                "amb",
                "nopause",
                "fallback"
              ]
            }
          ]
        }
      },
      "cues": {
        "type": "array",
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(\\d+:\\d+|bas\\d+|pre0)$"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      }
    }
  }
}
