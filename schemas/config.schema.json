{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "config",
  "type": "object",
  "required": [
    "schema",
    "version",
    "appVersion",
    "audio",
    "analytics",
    "contact"
  ],
  "properties": {
    "schema": {
      "const": "config"
    },
    "version": {
      "type": "string"
    },
    "audio": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "base": {
          "type": "string"
        }
      }
    },
    "analytics": {
      "type": "object",
      "properties": {
        "cloudflareToken": {
          "type": "string"
        }
      }
    }
  }
}
