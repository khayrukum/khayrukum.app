 "summary": [
  {
   "kind": "outline",
   "title": "الربع الخامس (٧٥–٩١): مواقف بني إسرائيل من الكتاب والميثاق",
   "items": [
    {
     "range": "2:75-77",
     "text": "اليأس من إيمانهم «[[q:2:75:1-4]]»، وتحريفهم كلام الله ونفاقهم"
    },
    {
     "range": "2:78-79",
     "text": "الأميون، والويل لمن يحرّفون «[[q:2:79:1-5]]»"
    },
    {
     "range": "2:80-82",
     "text": "دعواهم «[[q:2:80:2-7]]»، والرد: أصحاب النار وأصحاب الجنة"
    },
    {
     "range": "2:83",
     "text": "ميثاق بني إسرائيل «[[q:2:83:6-9]]»"
    },
    {
     "range": "2:84-86",
     "text": "ميثاق الدماء والديار ونقضه «[[q:2:85:23-27]]»"
    },
    {
     "range": "2:87-88",
     "text": "تكذيب الرسل وقتلهم «[[q:2:87:25-28]]»، وقولهم «[[q:2:88:2-3]]»"
    },
    {
     "range": "2:89-91",
     "text": "كفرهم بالقرآن بعد أن كانوا يستفتحون به «[[q:2:90:1-4]]»"
    }
   ]
  },
  {
   "kind": "outline",
   "title": "الربع السادس (٩٢–١٠٥): من العجل إلى السحر",
   "items": [
    {
     "range": "2:92-93",
     "text": "اتخاذ العجل ورفع الطور «[[q:2:93:13-14]]»"
    },
    {
     "range": "2:94-96",
     "text": "تحدّيهم «[[q:2:94:13-14]]»، وحرصهم على الحياة «[[q:2:96:9-14]]»"
    },
    {
     "range": "2:97-98",
     "text": "عداوتهم لجبريل «[[q:2:97:2-5]]»"
    },
    {
     "range": "2:99-101",
     "text": "الآيات البينات، ونبذ العهد «[[q:2:100:1-6]]»، ونبذ كتاب الله وراء ظهورهم"
    },
    {
     "range": "2:102-103",
     "text": "السحر وهاروت وماروت «[[q:2:102:1-4]]»"
    },
    {
     "range": "2:104-105",
     "text": "أول نداء للمؤمنين «[[q:2:104:1-6]]»، وحسد أهل الكتاب"
    }
   ]
  },
